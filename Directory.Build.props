<Project>
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <Deterministic>true</Deterministic>
    <!-- Keep the product version free of the git commit, so a clone rebuilds the released DLL bytes. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <Version>0.4.0</Version>
    <LoaderProfile Condition="'$(LoaderProfile)' == ''">Offline</LoaderProfile>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)obj/$(LoaderProfile)/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)bin/$(LoaderProfile)/</BaseOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/bin/**;**/obj/**</DefaultItemExcludes>
    <PathMap Condition="'$(Configuration)' == 'Release'">$(MSBuildProjectDirectory)=/_/DungeonSettlersDelvers/$(MSBuildProjectName)</PathMap>
  </PropertyGroup>
</Project>
